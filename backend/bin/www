#!/usr/bin/env node

import '../src/config/environment.js'
import createDebug from 'debug'
import http from 'node:http'
import { once } from 'node:events'
import { connectDatabase, disconnectDatabase } from '../src/database-connection.js'

const debug = createDebug('app:server')
const shutdownTimeoutMS = 8000

function normalizePort(value) {
  const port = Number.parseInt(value, 10)
  if (Number.isNaN(port)) return value
  if (port >= 0) return port
  throw new Error('PORT must be a non-negative number or a named pipe.')
}

async function main() {
  // Construct the session store only after its shared MongoDB client is ready.
  await connectDatabase()
  const { default: app } = await import('../src/app.js')
  const port = normalizePort(process.env.PORT || '3000')
  app.set('port', port)
  const server = http.createServer(app)
  server.listen(port)
  await once(server, 'listening')
  debug('Listening on %s', typeof port === 'string' ? port : server.address().port)

  let shuttingDown = false
  async function shutdown(exitCode = 0) {
    if (shuttingDown) return
    shuttingDown = true
    app.locals.shuttingDown = true
    const timeout = setTimeout(() => {
      console.error('Graceful shutdown timed out.')
      server.closeAllConnections()
      process.exit(1)
    }, shutdownTimeoutMS)
    timeout.unref()

    try {
      await new Promise((resolve, reject) => {
        server.close(error => (error ? reject(error) : resolve()))
      })
      await disconnectDatabase()
      process.exitCode = exitCode
      clearTimeout(timeout)
    } catch (error) {
      console.error('Shutdown failed:', error.message)
      process.exitCode = 1
      // Keep the deadline active if cleanup failed and resources remain open.
    }
  }

  process.on('SIGTERM', () => void shutdown())
  process.on('SIGINT', () => void shutdown())
  server.on('error', error => {
    console.error('HTTP server failed:', error.code || error.name)
    void shutdown(1)
  })
}

main().catch(async error => {
  // Do not log the connection URI or credentials on startup failure.
  console.error('Server startup failed:', error.code || error.name)
  process.exitCode = 1
  await disconnectDatabase()
})
